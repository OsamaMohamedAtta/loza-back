# Copy to .env for local development. Set the real values in Render -> Environment.
# Never commit real keys.

# Existing settings
PORT=3000
ONLINE_CONNECTION_DB=
TOKEN_SECRET_KEY=
AUTH_SECRET_KEY=
# RATE_LIMIT_MAX=50

# PayTabs (server-side only, never put these in the website)
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=EGY
PAYTABS_CURRENCY=EGP
PAYTABS_CALLBACK_URL=https://lozatv-back-app.onrender.com/payment/callback
PAYTABS_RETURN_URL=https://lozatv-back-app.onrender.com/payment/return
FRONTEND_DASHBOARD_URL=https://lozatv.com/dashboard.html

# Actual prices charged in EGP. $5 (annual) and $10 (lifetime) are reference prices only.
ANNUAL_PRICE_EGP=
LIFETIME_PRICE_EGP=

# Optional
# PAYMENT_PENDING_EXPIRY_MINUTES=120
# SUBSCRIPTION_START_ENABLED=false
